rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // User profile photo storage rules:
    // Any user can view photos, but only the authenticated owner can write their own files under 5MB.
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Emergency SOS Audio Evidence storage:
    // Required: sos-audio/{file} allows public read (no login needed for Guardian view)
    // and upload write from traveler device
    match /sos-audio/{file} {
      allow read: if true;
      allow write: if true;
    }

    match /sos_audio/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
